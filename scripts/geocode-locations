#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ./scripts/geocode-locations [--refresh] [limit] [service]

Examples:
  ./scripts/geocode-locations
  ./scripts/geocode-locations 100
  ./scripts/geocode-locations --refresh 100

Queues one bounded per-photo place-resolution batch (default 100, maximum 1000).
Known manual assignments are preserved. Legacy owner-entered photo locations
are restored from their own metadata without a Google request. Other unresolved
photos use throttled, cached reverse geocoding when an API key is configured.
--refresh also rematches automatic assignments; it never deletes saved places,
legacy names, or manual edits. Refresh selects the oldest metadata first and
successful matches advance the next batch. Wait for each batch's photo jobs to
finish before repeating it; failed lookups remain retryable. No further batches
are queued automatically.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

REFRESH="0"
if [[ "${1:-}" == "--refresh" ]]; then
  REFRESH="1"
  shift
fi

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

LIMIT="${1:-100}"
SERVICE="${2:-web}"
if [[ ! "$LIMIT" =~ ^[0-9]{1,4}$ ]] || (( 10#$LIMIT < 1 || 10#$LIMIT > 1000 )) || (( $# > 2 )); then
  printf '%s\n' 'Limit must be an integer from 1 to 1000.' >&2
  exit 2
fi
if [[ ! "$SERVICE" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
  printf '%s\n' 'Service must be a Compose service name.' >&2
  exit 2
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose_env"
load_compose_env

docker compose exec -T \
  -e GEOCODE_LIMIT="$LIMIT" \
  -e GEOCODE_REFRESH="$REFRESH" \
  "$SERVICE" bin/rails runner "$(cat <<'RUBY'
limit = Integer(ENV.fetch("GEOCODE_LIMIT", "100"), 10)
refresh = ENV.fetch("GEOCODE_REFRESH", "0") == "1"
GeocodeMissingPhotoLocationsJob.perform_later(limit: limit, refresh: refresh)
puts "Queued a place-resolution batch for up to #{limit} photos#{refresh ? ' including automatic rematches' : ''}."
puts "External lookups require a configured geocoding key; manual restoration does not."
RUBY
)"

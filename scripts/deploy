#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

log() {
  printf "\n==> %s\n" "$*"
}

fail() {
  printf "\nDeploy failed: %s\n" "$*" >&2
  exit 1
}

compose() {
  docker compose "$@"
}

require_file() {
  [[ -f "$1" ]] || fail "missing $1. Copy the matching .example file and fill it in."
}

append_compose_profile() {
  local profile="$1"
  local profiles=",${COMPOSE_PROFILES:-},"

  if [[ "$profiles" != *",$profile,"* ]]; then
    COMPOSE_PROFILES="${COMPOSE_PROFILES:+$COMPOSE_PROFILES,}$profile"
  fi
}

require_clean_tracked_worktree() {
  git diff --quiet || fail "tracked files have unstaged changes. Commit, stash, or inspect them before deploying."
  git diff --cached --quiet || fail "tracked files have staged changes. Commit, stash, or inspect them before deploying."
}

container_state() {
  local service="$1"
  local container_id

  container_id="$(compose ps -q "$service")"
  [[ -n "$container_id" ]] || {
    printf "missing"
    return
  }

  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container_id"
}

container_id_for() {
  local service="$1"

  compose ps -q "$service" 2>/dev/null || true
}

wait_for_state() {
  local service="$1"
  local expected="$2"
  local timeout_seconds="$3"
  local elapsed=0
  local state

  while (( elapsed < timeout_seconds )); do
    state="$(container_state "$service")"

    if [[ "$state" == "$expected" ]]; then
      printf "%s is %s\n" "$service" "$state"
      return 0
    fi

    if [[ "$state" == "exited" || "$state" == "dead" || "$state" == "unhealthy" ]]; then
      compose logs --tail=120 "$service" >&2 || true
      fail "$service is $state"
    fi

    sleep 3
    elapsed=$((elapsed + 3))
  done

  compose logs --tail=120 "$service" >&2 || true
  fail "$service did not become $expected within ${timeout_seconds}s"
}

env_value() {
  local key="$1"
  local file="$2"

  awk -F= -v key="$key" '$1 == key { print substr($0, length(key) + 2); exit }' "$file"
}

wait_for_new_container() {
  local service="$1"
  local old_container_id="$2"
  local timeout_seconds="$3"
  local elapsed=0
  local container_id

  while (( elapsed < timeout_seconds )); do
    container_id="$(container_id_for "$service")"
    if [[ -n "$container_id" && "$container_id" != "$old_container_id" ]]; then
      printf "%s container recreated\n" "$service"
      return 0
    fi

    sleep 1
    elapsed=$((elapsed + 1))
  done

  fail "$service container was not recreated within ${timeout_seconds}s"
}

active_upstream_file() {
  printf "%s\n" "tmp/nginx/active_upstream.conf"
}

write_active_upstream() {
  local service="$1"
  local upstream_file

  upstream_file="$(active_upstream_file)"
  mkdir -p "$(dirname "$upstream_file")"
  printf "upstream photos_app { server %s:80; }\n" "$service" > "$upstream_file"
}

configured_web_service() {
  local upstream_file

  upstream_file="$(active_upstream_file)"
  [[ -f "$upstream_file" ]] || {
    printf "web_blue"
    return
  }

  if grep -q "web_green" "$upstream_file"; then
    printf "web_green"
  else
    printf "web_blue"
  fi
}

other_web_service() {
  case "$1" in
    web_blue) printf "web_green" ;;
    *) printf "web_blue" ;;
  esac
}

healthy_service() {
  [[ "$(container_state "$1")" == "healthy" ]]
}

active_web_service() {
  local serving
  local configured
  local other

  configured="$(configured_web_service)"
  if serving="$(proxy_backend)"; then
    case "$serving" in
      web_blue|web_green) printf "%s" "$serving" ;;
      *) printf "%s" "$configured" ;; # Older backends answer without a marker.
    esac
    return
  fi

  other="$(other_web_service "$configured")"

  if healthy_service "$configured"; then
    printf "%s" "$configured"
  elif healthy_service "$other"; then
    printf "%s" "$other"
  else
    printf "%s" "$configured"
  fi
}

remove_legacy_web_container() {
  local legacy_container

  legacy_container="$(docker ps -aq \
    --filter "label=com.docker.compose.project=photos" \
    --filter "label=com.docker.compose.service=web" \
    | head -n 1)"
  [[ -n "$legacy_container" ]] || return 0

  printf "removing legacy web container %s before binding app_proxy to port 3000\n" "$legacy_container"
  docker stop "$legacy_container" >/dev/null || true
  docker rm "$legacy_container" >/dev/null || true
}

reload_app_proxy() {
  local update_image="$1"

  if [[ "$update_image" == 1 ]]; then
    # Validate the newly pulled image and checkout before replacing the only
    # proxy. A recreated bind mount also picks up replaced nginx config files.
    compose run --rm --no-deps app_proxy nginx -t || return 1
    compose up -d --no-deps --force-recreate app_proxy || return 1
  elif [[ "$(container_state app_proxy)" != "running" ]]; then
    compose up -d --no-deps --no-recreate app_proxy || return 1
  fi

  compose exec -T app_proxy nginx -t && compose exec -T app_proxy nginx -s reload
}

proxy_backend() {
  local timeout_seconds="${1:-3}"
  local app_host

  app_host="$(env_value PHOTOS_HOST .env.production)"
  app_host="${app_host:-photos.example.com}"
  curl --noproxy '*' -fsSI --max-time "$timeout_seconds" -H "Host: ${app_host}" "http://127.0.0.1:3000/up" 2>/dev/null |
    awk '
      /^HTTP\// { status = $2; backend = "" }
      tolower($1) == "x-photos-backend:" { sub(/\r$/, "", $2); backend = $2 }
      END { if (status == 200) print backend; else exit 1 }
    '
}

wait_for_proxy_http() {
  local expected_backend="$1"
  local timeout_seconds="$2"
  local deadline=$((SECONDS + timeout_seconds))
  local backend remaining

  while (( (remaining = deadline - SECONDS) > 0 )); do
    if backend="$(proxy_backend "$((remaining < 3 ? remaining : 3))")" && [[ "$backend" == "$expected_backend" ]]; then
      printf "app_proxy routed /up to %s\n" "${backend:-the previous backend without a deployment marker}"
      return 0
    fi

    sleep 1
  done

  compose logs --tail=120 app_proxy >&2 || true
  printf "app_proxy did not route /up to %s within %ss\n" "${expected_backend:-the previous backend without a deployment marker}" "$timeout_seconds" >&2
  return 1
}

require_proxy_not_draining() {
  local processes
  [[ "$(container_state app_proxy)" == "running" ]] || return 0
  processes="$(compose exec -T app_proxy ps -o pid,args)" || fail "could not inspect app_proxy workers"
  if [[ "$processes" == *"nginx: worker process is shutting down"* ]]; then
    fail "app_proxy is still draining connections from a previous release"
  fi
}

proxy_worker_pids() {
  compose exec -T app_proxy ps -o pid,args |
    awk '$2 == "nginx:" && $3 == "worker" && $4 == "process" { printf "%s ", $1 }'
}

wait_for_proxy_drain() {
  local previous_proxy_id="$1"
  local previous_workers=()
  local elapsed=0
  local proxy_id workers pid
  read -r -a previous_workers <<< "$2"

  while (( elapsed < 30 )); do
    proxy_id="$(compose ps -q app_proxy)" || return 1
    [[ -n "$proxy_id" ]] || return 1
    [[ "$proxy_id" == "$previous_proxy_id" ]] || return 0
    workers="$(proxy_worker_pids)" || return 1
    for pid in "${previous_workers[@]}"; do
      [[ " $workers " == *" $pid "* ]] && break
    done
    [[ " $workers " != *" $pid "* ]] && return 0
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

switch_web_backend() {
  local next_web="$1"
  local proxy_existed="$2"
  local upstream_file previous_upstream previous_backend

  upstream_file="$(active_upstream_file)"
  previous_upstream=""
  previous_backend=""
  if [[ -f "$upstream_file" ]]; then
    previous_upstream="$(cat "$upstream_file")" || fail "could not save previous app_proxy upstream"
  fi
  previous_backend="$(proxy_backend)" || previous_backend=""
  if [[ "$previous_backend" == web_blue || "$previous_backend" == web_green ]]; then
    printf -v previous_upstream 'upstream photos_app { server %s:80; }' "$previous_backend"
  fi

  write_active_upstream "$next_web" || fail "could not write app_proxy upstream"
  remove_legacy_web_container
  if reload_app_proxy "$update_infrastructure" && wait_for_proxy_http "$next_web" 60; then
    return 0
  fi

  if [[ -n "$previous_upstream" ]]; then
    # The bind mount follows this file's inode, so restore its contents in place.
    printf "%s\n" "$previous_upstream" > "$upstream_file" || fail "could not restore previous app_proxy upstream"
    if [[ -n "$proxy_existed" ]] && reload_app_proxy 0 && wait_for_proxy_http "$previous_backend" 30; then
      fail "web cutover failed; the previous app_proxy upstream was restored"
    fi
  fi
  fail "web cutover failed; check app_proxy configuration and logs"
}

cleanup_old_images() {
  local container_id
  local project

  if [[ "${PHOTOS_DOCKER_CLEANUP:-1}" == 0 ]]; then
    printf "Photos image cleanup disabled for this deploy\n"
    return
  fi

  # Discover the actual Compose project rather than assuming the checkout name.
  # Positive labels keep cleanup away from other apps on this Docker host.
  container_id="$(container_id_for worker)"
  if ! project="$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' "$container_id")" ||
    [[ ! "$project" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
    printf "Warning: could not identify the Compose project; image cleanup skipped.\n" >&2
    return
  fi

  # Without --all, only dangling images are eligible. Docker also preserves
  # images referenced by stopped containers, including our previous backend.
  if ! docker image prune --force --filter "label=com.docker.compose.project=$project" --filter "until=168h"; then
    printf "Warning: Photos image cleanup failed; the healthy deployment is still complete.\n" >&2
  fi
}

require_file ".env.production"
require_file ".env.postgres"
command -v flock >/dev/null || fail "missing flock (provided by util-linux)"
mkdir -p tmp
exec 9>tmp/deploy.lock
flock -n 9 || fail "another deployment is running"
require_clean_tracked_worktree
[[ "${PHOTOS_DOCKER_CLEANUP:-1}" =~ ^[01]$ ]] || fail "PHOTOS_DOCKER_CLEANUP must be 0 or 1"
update_infrastructure="${PHOTOS_UPDATE_INFRASTRUCTURE:-0}"
[[ "$update_infrastructure" =~ ^[01]$ ]] || fail "PHOTOS_UPDATE_INFRASTRUCTURE must be 0 or 1"

storage_path="$(env_value PHOTOS_STORAGE_PATH .env.production)"
[[ -n "$storage_path" ]] || fail "PHOTOS_STORAGE_PATH must be set in .env.production"
[[ -d "$storage_path" ]] || fail "PHOTOS_STORAGE_PATH does not exist or is not a directory: $storage_path"
export PHOTOS_STORAGE_PATH="$storage_path"
COMPOSE_PROFILES="${COMPOSE_PROFILES:-bluegreen}"
append_compose_profile bluegreen
append_compose_profile analysis
export COMPOSE_PROFILES

require_storage_mount() {
  local service="$1"
  local container_id
  local mounted_source

  container_id="$(compose ps -q "$service")"
  [[ -n "$container_id" ]] || fail "$service container is missing"

  mounted_source="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/rails/storage"}}{{.Source}}{{end}}{{end}}' "$container_id")"
  [[ "$mounted_source" == "$storage_path" ]] || {
    compose logs --tail=80 "$service" >&2 || true
    fail "$service mounted /rails/storage from ${mounted_source:-nothing}, expected $storage_path"
  }
}

log "Pulling latest code"
git pull --ff-only

log "Validating compose configuration"
compose config >/dev/null
require_proxy_not_draining

if [[ "$update_infrastructure" == 1 ]]; then
  log "Pulling infrastructure images for maintenance"
  compose pull db redis app_proxy
fi

log "Building application image"
compose build --pull web_blue

log "Building local analysis image (unchanged layers are cached)"
compose build --pull analysis-local

log "Starting infrastructure"
if [[ "$update_infrastructure" == 1 ]]; then
  compose up -d db redis
else
  compose up -d --no-recreate db redis
fi
wait_for_state db healthy 120
wait_for_state redis healthy 120

log "Starting local analysis"
compose up -d --no-deps analysis-local
require_storage_mount analysis-local
wait_for_state analysis-local healthy 600

log "Preparing database"
compose run --rm --no-deps web_blue ./bin/rails db:prepare

log "Starting web"
active_web="$(active_web_service)"
next_web="$(other_web_service "$active_web")"
old_next_container="$(container_id_for "$next_web")"
printf "active web: %s; next web: %s\n" "$active_web" "$next_web"

SKIP_DB_PREPARE=true compose up -d --no-deps --force-recreate "$next_web"
wait_for_new_container "$next_web" "$old_next_container" 60
require_storage_mount "$next_web"
wait_for_state "$next_web" healthy 240

previous_proxy_id="$(compose ps -q app_proxy)" || fail "could not identify the current app_proxy container"
previous_workers=""
if [[ -n "$previous_proxy_id" ]]; then
  previous_workers="$(proxy_worker_pids)" || fail "could not identify app_proxy workers before cutover"
  [[ "$previous_workers" =~ ^[0-9]+([[:space:]]+[0-9]+)*[[:space:]]*$ ]] || fail "app_proxy has no identifiable workers before cutover"
fi
switch_web_backend "$next_web" "$previous_proxy_id"

if [[ -n "$(container_id_for "$active_web")" ]]; then
  if [[ -z "$previous_proxy_id" ]] || wait_for_proxy_drain "$previous_proxy_id" "$previous_workers"; then
    compose stop "$active_web"
  else
    printf "Warning: app_proxy is still draining; leaving %s running.\n" "$active_web" >&2
  fi
fi

log "Starting worker"
compose up -d --no-deps worker --remove-orphans
require_storage_mount worker
wait_for_state worker running 120

log "Cleaning old dangling Photos images (keeping the last seven days)"
cleanup_old_images

log "Docker disk usage (shared host)"
docker system df || printf "Warning: Docker disk usage could not be reported.\n" >&2

log "Current status"
compose ps

cat <<'MSG'

Deploy complete.

Useful follow-ups:
  ./scripts/logs
  ./scripts/logs web
  ./scripts/logs all
  docker compose logs -f analysis-local
  docker compose exec worker bin/rails console
MSG

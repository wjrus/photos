#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  ./scripts/audit-location-metadata [place-or-location-id] [limit] [service]

Examples:
  ./scripts/audit-location-metadata Kula
  ./scripts/audit-location-metadata London 100
  ./scripts/audit-location-metadata place-id-42 25
  ./scripts/audit-location-metadata area-831_-6253 25
  ./scripts/audit-location-metadata 831_-6253 25

Shows current per-photo PhotoPlace assignments, canonical provider identities,
manual/automatic sources, and separate map-only region descriptors, followed by
Takeout paths, sidecar coordinates, and raw EXIF GPS values when present.
Text matches current place names/aliases and map-region names; an exact identity
or map-region key also works. place-id-N selects one actual place. area-CELL
selects unresolved photos only; a raw CELL selects all photos in that area.
Legacy name-only IDs search the decoded name among current assignments, without
using old shared grid labels. Equal names remain separately identified places.
The default photo limit is 50; accepted limits are 1 through 1000. This diagnostic
only reads data and never geocodes, repairs metadata, or changes assignments.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

QUERY="${1:-Kula}"
LIMIT="${2:-50}"
SERVICE="${3:-web}"
if [[ ! "$LIMIT" =~ ^[0-9]{1,4}$ ]] || (( 10#$LIMIT < 1 || 10#$LIMIT > 1000 )) || (( $# > 3 )); then
  printf '%s\n' 'Limit must be an integer from 1 to 1000.' >&2
  exit 2
fi
if [[ ! "$SERVICE" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
  printf '%s\n' 'Service must be a Compose service name.' >&2
  exit 2
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
source "$ROOT/scripts/lib/compose_env"
load_compose_env

docker compose exec -T \
  -e AUDIT_QUERY="$QUERY" \
  -e AUDIT_LIMIT="$LIMIT" \
  "$SERVICE" bin/rails runner "$(cat <<'RUBY'
query = ENV.fetch("AUDIT_QUERY")
limit = Integer(ENV.fetch("AUDIT_LIMIT", "50"), 10)

scope = Photo.not_archived.where(restricted: false)
  .joins(:metadata).merge(PhotoMetadata.geotagged)
  .includes(metadata: :photo_place)

if PhotoLocation.legacy_place_id?(query)
  decoded = PhotoLocation.place_name_from_id(query)
  abort "Invalid legacy name-only location ID." if decoded.blank?

  puts "Legacy name-only ID: searching current assignments for #{decoded.inspect}."
  query = decoded
elsif PhotoLocation.valid_id?(query)
  scope = PhotoLocation.scope_for(scope, query)
  spatial_or_place_id = true
end

unless spatial_or_place_id
  pattern = "%#{ActiveRecord::Base.sanitize_sql_like(query)}%"
  places = PhotoPlace.matching_name(pattern)
    .or(PhotoPlace.where("map_region_name ILIKE ?", pattern))
    .or(PhotoPlace.where(identity_key: query))
    .or(PhotoPlace.where(map_region_key: query))
  scope = scope.where(photo_metadata: { photo_place_id: places.select(:id) })
end

photos = scope.order(Arel.sql("COALESCE(photos.captured_at, photos.created_at) DESC, photos.id DESC"))
  .limit(limit).to_a
if photos.empty?
  puts "No current photos matched #{query.inspect}. Legacy shared grid labels are not current assignments."
  exit
end

places = photos.filter_map { |photo| photo.metadata.photo_place }.uniq(&:id).sort_by { |place| [ place.name, place.id ] }
puts "Showing #{photos.size} #{'photo'.pluralize(photos.size)} for #{query.inspect} (limit #{limit})."
puts "Assigned places represented in these photos:"
puts "  (none; these photos are unresolved)" if places.empty?
places.each do |place|
  puts "  #{PhotoLocation.id_for_place(place)} #{place.name}"
  puts "    identity: #{place.identity_key} type=#{place.place_type || 'unspecified'}"
  puts "    map rollup (display only): #{place.map_region_name || '(none)'} #{place.map_region_key}"
end

imports = GoogleTakeoutImport.where(photo_id: photos.map(&:id)).index_by(&:photo_id)
photos.each do |photo|
  metadata = photo.metadata
  place = metadata.photo_place
  raw = metadata.raw.to_h
  google = raw.fetch("google_takeout", {}).to_h
  google_exif = google.fetch("geoDataExif", {}).to_h
  google_geo = google.fetch("geoData", {}).to_h
  source = metadata.location_source.presence || (place ? 'unspecified' : 'unresolved')

  puts
  puts "photo ##{photo.id} #{photo.original_filename}"
  puts "  captured: #{photo.captured_at || metadata.captured_at || 'unknown'}"
  puts "  current:  #{metadata.latitude}, #{metadata.longitude} -> #{PhotoLocation.id_for_metadata(metadata)} #{place&.name || '(unresolved)'}"
  puts "  source:   #{source}"
  puts "  takeout:  #{imports[photo.id]&.entry_name || '(no import record)'}"
  puts "  google:   geoDataExif=#{google_exif['latitude']},#{google_exif['longitude']} geoData=#{google_geo['latitude']},#{google_geo['longitude']}"
  puts "  exif:     #{raw['GPSLatitudeRef']} #{raw['GPSLatitude']} / #{raw['GPSLongitudeRef']} #{raw['GPSLongitude']}"
end
RUBY
)"

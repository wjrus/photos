GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=
GOOGLE_MAPS_EMBED_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_MAPS_MAP_ID=
PHOTOS_OWNER_EMAIL=
PHOTOS_TRUSTED_VIEWER_EMAILS=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com
MAILGUN_FROM=photos@example.invalid
MAILGUN_FROM_NAME=Photos
# MAILGUN_REPLY_TO=photos@example.invalid
# MAILGUN_API_BASE=https://api.mailgun.net

# Runtime repository controls, such as original file auto-heal, live in the app
# settings table and are managed from Repository Status.

# Photo analysis is opt-in by provider from Repository Status. Local OpenCLIP
# and YOLO processors should run in a Docker sidecar. OpenAI stays disabled
# until an owner explicitly enables it and configures a server-side key.
ANALYSIS_LOCAL_CONTAINER_URL=http://analysis-local:8000
ANALYSIS_BACKFILL_BATCH_SIZE=100
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
OPENROUTER_BUDGET_USD=100
OPENROUTER_ESTIMATED_COST_USD=0.0025
OPENAI_API_KEY=

# Prodigi keys stay on the server. Use the key for the matching environment.
PRODIGI_ENVIRONMENT=sandbox
PRODIGI_SANDBOX_API_KEY=
PRODIGI_LIVE_API_KEY=
PRODIGI_LIVE_ORDERING_ENABLED=false
# Public artwork and webhook URLs use https://PHOTOS_HOST.
# Optional override for a different public origin (e.g. a development tunnel):
# PRODIGI_PUBLIC_BASE_URL=https://photos.example.com
PRODIGI_WEBHOOK_SECRET=
# Optional overrides; these layflat product codes are built in:
# PRODIGI_SKU_LANDSCAPE_A4=BOOK-FE-A4-L-LF-G
# PRODIGI_SKU_SQUARE_210=BOOK-FE-8_3-SQ-LF-G
# PRODIGI_SKU_SQUARE_297=BOOK-FE-11_7-SQ-LF-G

# Optional: override local database access if your PostgreSQL setup needs it.
# DATABASE_URL=postgres://postgres@localhost:5432/photos_development

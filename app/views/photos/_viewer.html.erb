<main class="photo-viewer-shell relative flex items-center justify-center overflow-hidden bg-zinc-950 p-0 transition-[padding] duration-200 ease-out"
      data-controller="stream-navigation photo-zoom"
      data-action="keydown@window->stream-navigation#keydown touchstart->stream-navigation#touchstart touchend->stream-navigation#touchend wheel->stream-navigation#wheel"
      data-info-panel-target="viewer"
      data-stream-navigation-back-url-value="<%= return_to %>"
      data-stream-navigation-previous-url-value="<%= photo_path(previous_photo, local_assigns[:access_params] || {}) if previous_photo %>"
      data-stream-navigation-next-url-value="<%= photo_path(next_photo, local_assigns[:access_params] || {}) if next_photo %>"
      data-stream-navigation-previous-media-url-value="<%= photo_neighbor_prefetch_media_path(previous_photo) if previous_photo %>"
      data-stream-navigation-next-media-url-value="<%= photo_neighbor_prefetch_media_path(next_photo) if next_photo %>">
  <div class="photo-viewer-topbar absolute inset-x-0 top-0 z-30 flex items-start justify-between px-3 pb-8 pt-3 sm:px-4 sm:pt-4">
    <%= link_to return_to,
          class: "ui-tooltip ui-tooltip--left photo-viewer-action flex size-11 items-center justify-center rounded-full text-white transition hover:bg-white/20 focus-visible:bg-white/20",
          aria: { label: "Return to stream" },
          data: { tooltip: "Return to stream" } do %>
      <%= app_icon(:chevron_left, classes: "size-7") %>
      <span class="sr-only">Return to stream</span>
    <% end %>

    <div class="flex items-center gap-1">
      <div class="photo-zoom-controls flex items-center justify-end"
           data-photo-zoom-target="controls">
        <button type="button"
                class="ui-tooltip photo-viewer-action flex size-11 cursor-pointer items-center justify-center rounded-full text-white transition hover:bg-white/20 focus-visible:bg-white/20"
                aria-label="Show zoom controls"
                title="Show zoom controls"
                data-tooltip="Zoom"
                data-photo-zoom-target="toggleButton"
                data-action="photo-zoom#toggle">
          <%= app_icon(:zoom_in, classes: "size-5") %>
          <span class="sr-only">Show zoom controls</span>
        </button>

        <div class="hidden items-center gap-1 rounded-full bg-black/35 p-1 text-white shadow-lg ring-1 ring-white/15 backdrop-blur-md"
             data-photo-zoom-target="panel">
          <button type="button"
                  class="ui-tooltip flex size-9 cursor-pointer items-center justify-center rounded-full transition hover:bg-white hover:text-zinc-950 disabled:cursor-not-allowed disabled:opacity-40"
                  aria-label="Zoom out"
                  title="Zoom out"
                  data-tooltip="Zoom out"
                  data-photo-zoom-target="zoomOutButton"
                  data-action="photo-zoom#zoomOut">
            <%= app_icon(:zoom_out, classes: "size-5") %>
            <span class="sr-only">Zoom out</span>
          </button>
          <button type="button"
                  class="min-w-14 cursor-pointer rounded-full px-2 py-1 text-center text-xs font-semibold tabular-nums transition hover:bg-white hover:text-zinc-950"
                  aria-label="Reset zoom"
                  title="Reset zoom"
                  data-photo-zoom-target="percent"
                  data-action="photo-zoom#reset">
            100%
          </button>
          <button type="button"
                  class="ui-tooltip flex size-9 cursor-pointer items-center justify-center rounded-full transition hover:bg-white hover:text-zinc-950 disabled:cursor-not-allowed disabled:opacity-40"
                  aria-label="Zoom in"
                  title="Zoom in"
                  data-tooltip="Zoom in"
                  data-photo-zoom-target="zoomInButton"
                  data-action="photo-zoom#zoomIn">
            <%= app_icon(:zoom_in, classes: "size-5") %>
            <span class="sr-only">Zoom in</span>
          </button>
          <button type="button"
                  class="ui-tooltip flex size-9 cursor-pointer items-center justify-center rounded-full transition hover:bg-white hover:text-zinc-950"
                  aria-label="Hide zoom controls"
                  title="Hide zoom controls"
                  data-tooltip="Hide zoom"
                  data-action="photo-zoom#hide">
            <%= app_icon(:x, classes: "size-5") %>
            <span class="sr-only">Hide zoom controls</span>
          </button>
        </div>
      </div>

      <button type="button"
              class="ui-tooltip photo-viewer-action flex size-11 items-center justify-center rounded-full font-serif text-lg font-semibold italic text-white transition hover:bg-white/20 focus-visible:bg-white/20"
              aria-label="Show photo information"
              title="Show photo information"
              data-tooltip="Info"
              aria-controls="photo-info-panel"
              aria-expanded="false"
              data-info-panel-target="button"
              data-info-panel-button
              data-action="info-panel#toggle">
        i
      </button>
    </div>
  </div>

  <% if previous_photo || next_photo %>
    <nav class="photo-stream-navigation absolute right-4 top-1/2 z-20 flex flex-col gap-2" aria-label="Stream navigation">
      <% if previous_photo %>
        <%= link_to photo_path(previous_photo, local_assigns[:access_params] || {}),
              class: "ui-tooltip photo-viewer-action flex size-11 items-center justify-center rounded-full text-white transition hover:bg-white/20 focus-visible:bg-white/20",
              aria: { label: "Previous item in stream" },
              data: { turbo_action: "replace", tooltip: "Previous item", action: "stream-navigation#previous" } do %>
          <%= app_icon(:chevron_up, classes: "size-7") %>
          <span class="sr-only">Previous item in stream</span>
        <% end %>
      <% end %>
      <% if next_photo %>
        <%= link_to photo_path(next_photo, local_assigns[:access_params] || {}),
              class: "ui-tooltip photo-viewer-action flex size-11 items-center justify-center rounded-full text-white transition hover:bg-white/20 focus-visible:bg-white/20",
              aria: { label: "Next item in stream" },
              data: { turbo_action: "replace", tooltip: "Next item", action: "stream-navigation#next" } do %>
          <%= app_icon(:chevron_down, classes: "size-7") %>
          <span class="sr-only">Next item in stream</span>
        <% end %>
      <% end %>
    </nav>
  <% end %>

  <div class="photo-zoom-frame flex max-h-full max-w-full items-center justify-center"
       role="region"
       tabindex="0"
       aria-label="Zoomed photo viewport. Use arrow keys to pan while zoomed."
       data-action="keydown->photo-zoom#keydown"
       data-photo-zoom-target="frame">
    <%= photo_detail_media(photo, access_params: local_assigns[:access_params] || {}) %>
  </div>

  <div class="photo-zoom-minimap pointer-events-none absolute right-4 top-[4.75rem] z-20 hidden w-36 overflow-hidden rounded-lg border border-white/25 bg-black/55 p-1 shadow-lg backdrop-blur transition-[right] duration-200 ease-out"
       aria-hidden="true"
       data-photo-zoom-target="minimap">
    <div class="relative bg-zinc-950/80"
         data-photo-zoom-target="minimapImage">
      <div class="absolute border-2 border-white bg-white/15 shadow-[0_0_0_1px_rgba(0,0,0,0.45)]"
           data-photo-zoom-target="minimapViewport"></div>
    </div>
  </div>

  <p class="sr-only" aria-live="polite" data-photo-zoom-target="status">Zoom 100%.</p>
</main>

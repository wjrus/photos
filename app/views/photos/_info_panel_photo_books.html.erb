<% if photo.image? && !photo.restricted? && photo.archived_at.nil? %>
  <section class="border-b border-zinc-200 p-5">
    <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">Photobooks</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      <% photo.photo_books.where(owner_id: current_user.id).order(:title).each do |book| %>
        <%= link_to book.title, photo_book_path(book), class: "rounded-lg border border-zinc-200 px-3 py-2 text-xs font-semibold" %>
      <% end %>
    </div>
    <details class="mt-3">
      <summary class="cursor-pointer text-sm font-semibold">Add to photobook</summary>
      <%= form_with url: photo_photo_book_memberships_path(photo), class: "mt-3 space-y-3" do %>
        <%= hidden_field_tag :return_to, return_to %>
        <%= label_tag :info_photo_book_id, "Existing photobook", class: "block text-xs font-semibold" %>
        <%= select_tag :photo_book_id, options_from_collection_for_select(current_user.photo_books.order(:title, :id), :id, :title),
              include_blank: "Choose photobook", id: "info_photo_book_id", class: "w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
        <%= label_tag :info_new_photo_book_title, "New photobook", class: "block text-xs font-semibold" %>
        <%= text_field_tag :new_photo_book_title, nil, id: "info_new_photo_book_title", maxlength: 120, placeholder: "Book name", class: "w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
        <%= submit_tag "Add to photobook", class: "w-full rounded-lg bg-zinc-950 px-3 py-2 text-sm font-semibold text-white" %>
      <% end %>
    </details>
  </section>
<% end %>

<% content_for :title, @photo.title %>
<% content_for :body_class, "photo-detail-page" %>
<% content_for :head do %>
  <%# The viewer URL can be opened from several streams with different neighbors. %>
  <meta name="turbo-cache-control" content="no-preview">
  <%= photo_stream_neighbor_preload_tags(@previous_photo, @next_photo) %>
<% end %>
<% if @album_access_link %>
  <% content_for :head do %>
    <meta name="robots" content="noindex,nofollow">
  <% end %>
<% end %>
<% if @photo.public? && @photo.image? %>
  <% content_for :head do %>
  <meta property="og:site_name" content="Photos">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= photo_social_title(@photo) %>">
  <meta property="og:description" content="<%= photo_social_description(@photo) %>">
  <meta property="og:url" content="<%= photo_url(@photo, host: request.host_with_port, protocol: request.protocol) %>">
  <meta property="og:image" content="<%= photo_social_image_url(@photo) %>">
  <meta property="og:image:secure_url" content="<%= photo_social_image_url(@photo) %>">
  <meta property="og:image:type" content="<%= photo_social_image_type(@photo) %>">
  <meta property="og:image:alt" content="<%= photo_social_title(@photo) %>">
  <% if (metadata = @photo.display_metadata) && metadata.width.present? && metadata.height.present? %>
    <meta property="og:image:width" content="<%= metadata.width %>">
    <meta property="og:image:height" content="<%= metadata.height %>">
  <% end %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= photo_social_title(@photo) %>">
  <meta name="twitter:description" content="<%= photo_social_description(@photo) %>">
  <meta name="twitter:image" content="<%= photo_social_image_url(@photo) %>">
  <% end %>
<% end %>

<section class="photo-detail-frame relative overflow-hidden bg-zinc-950 text-zinc-950" data-controller="info-panel">
  <div class="photo-detail-frame w-full">
    <%= render "photos/viewer",
          photo: @photo,
          return_to: @return_to,
          previous_photo: @previous_photo,
          next_photo: @next_photo,
          access_params: @album_access_params || {} %>

    <aside id="photo-info-panel"
           class="fixed inset-y-0 right-0 z-40 w-full max-w-[390px] translate-x-full overflow-y-auto border-l border-zinc-200 bg-white shadow-2xl transition duration-200 ease-out"
           data-info-panel-target="panel">
      <%= turbo_frame_tag "photo-info-content", target: "_top", class: "block",
            data: { info_panel_target: "content", src: details_photo_path(@photo, (@album_access_params || {}).merge(return_to: @return_to)) } do %>
        <%= render "photos/info_panel_header", photo: @photo, owner_actions: false %>
        <p role="status" class="px-5 py-4 text-sm text-zinc-600">Loading photo details…</p>
      <% end %>
    </aside>
  </div>
</section>

<%= turbo_frame_tag "photo-info-content", target: "_top", class: "block" do %>
  <%= render "photos/info_panel_header", photo: photo, owner_actions: current_user&.owner?, return_to: return_to, cover_context: local_assigns[:cover_context] %>

  <% if privileged_metadata_viewer? || ((photo.public? || local_assigns[:album_access]) && photo.description.present?) %>
    <%= render "photos/info_panel_caption", photo: photo, return_to: return_to %>
  <% end %>

  <% if privileged_metadata_viewer? %>
    <%= render "photos/info_panel_albums", photo: photo, albums: local_assigns[:albums], return_to: return_to %>
  <% end %>

  <% if privileged_metadata_viewer? || (photo.public? && photo.tagged_users.any?) %>
    <%= render "photos/info_panel_people", photo: photo, taggable_users: taggable_users, return_to: return_to %>
  <% end %>

  <% if current_user&.owner? %>
    <%= render "photos/info_panel_photo_books", photo: photo, return_to: return_to %>
    <%= render "photos/info_panel_archive", photo: photo, return_to: return_to %>
  <% end %>

  <% if privileged_metadata_viewer? %>
    <%= render "photos/info_panel_analysis", photo: photo %>
    <%= render "photos/info_panel_metadata", photo: photo, return_to: return_to %>
  <% end %>
<% end %>

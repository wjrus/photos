<% content_for :title, "Locations" %>

<section class="min-h-screen bg-stone-50 text-zinc-950">
  <%= render "shared/site_header" %>

  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 border-b border-zinc-200 pb-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-3xl font-semibold text-zinc-950"><%= @legacy_place_name.present? ? "Choose a location" : "Locations" %></h1>
        <p class="mt-1 text-sm text-zinc-600"><%= pluralize(@location_count, "photo location") %></p>
        <% if @legacy_place_name.present? %>
          <p class="mt-2 text-sm text-zinc-600">The old link for <%= @legacy_place_name %> includes several places. Select the one you want.</p>
        <% end %>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <nav aria-label="Sort locations" class="flex min-h-11 items-center gap-1 rounded-lg border border-zinc-300 bg-white p-1 shadow-sm">
          <% sorts = @legacy_place_name.present? ? { "name" => "Name", "count" => "Photo count" } : { "geography" => "Geography", "name" => "Name", "count" => "Photo count" } %>
          <% sorts.each do |sort, label| %>
            <% sort_path = @legacy_place_name.present? ? location_path(@location_id, sort: sort) : locations_path(sort: sort) %>
            <%= link_to label, sort_path,
                  aria: { current: (@location_sort == sort ? "true" : nil) },
                  class: "whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-semibold transition #{@location_sort == sort ? 'bg-zinc-950 text-white' : 'text-zinc-700 hover:bg-zinc-100'}" %>
          <% end %>
        </nav>
        <%= link_to "Map",
              map_path,
              class: "inline-flex min-h-11 items-center justify-center whitespace-nowrap rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm font-semibold text-zinc-800 shadow-sm transition hover:border-zinc-950 hover:bg-zinc-950 hover:text-white" %>
      </div>
    </div>

    <% if @locations.any? %>
      <div class="mt-6"
           data-stream-page-container
           data-infinite-scroll-page-size-value="<%= LocationsController::LOCATION_PAGE_SIZE %>"
           data-controller="<%= "infinite-scroll" if @next_location_page.present? %>">
        <%= render "locations/page", locations: @locations %>
      </div>
    <% else %>
      <div class="mt-6 flex min-h-[340px] items-center justify-center rounded-lg border border-dashed border-zinc-300 bg-white p-8 text-center shadow-sm">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700">No locations</p>
          <h2 class="mt-3 text-2xl font-semibold text-zinc-950">No geotagged photos yet.</h2>
        </div>
      </div>
    <% end %>
  </main>
</section>

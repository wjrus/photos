<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3" data-location-card-grid>
  <% locations.each do |location| %>
    <% cover = @location_covers[location.id] %>
    <article class="group overflow-hidden rounded-lg border border-zinc-200 bg-white shadow-sm transition hover:border-zinc-950">
      <%= link_to location_path(location.id), class: "block" do %>
        <div class="aspect-[4/3] bg-zinc-900">
          <% if cover %>
            <%= photo_stream_media(cover) %>
          <% else %>
            <div class="flex size-full items-center justify-center text-xs font-semibold uppercase tracking-[0.18em] text-white/70">Location</div>
          <% end %>
        </div>
        <div class="p-4">
          <%= content_tag local_assigns.fetch(:heading_tag, :h2), location.title, class: "truncate text-lg font-semibold text-zinc-950", data: { location_title: true } %>
          <% if location.geographic_context.present? %><p class="mt-1 text-sm text-zinc-600" data-location-context><%= location.geographic_context %></p><% end %>
          <p class="mt-1 text-xs text-zinc-500"><%= location.place_type.present? ? location.place_type.humanize : "Area awaiting place matching" %> · <%= PhotoLocation.title_for(location.latitude, location.longitude) %></p>
          <p class="mt-1 text-sm text-zinc-600"><%= media_count_label(photo_count: location.image_count.to_i, video_count: location.video_count.to_i) %></p>
          <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-zinc-500" data-location-dates>
            <%= [ location.oldest_at.to_date, location.newest_at.to_date ].uniq.map { |date| photo_stream_day_label(date) }.join(" - ") %>
          </p>
        </div>
      <% end %>
    </article>
  <% end %>
</div>

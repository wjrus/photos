<% if @legacy_place_name.blank? %>
  <% locations.chunk { |location| location.country_name.to_s }.each do |country, country_locations| %>
    <section class="mb-8" data-location-country-group="<%= country %>" aria-label="<%= country.presence || "Other locations" %>">
      <h2 class="mb-4 border-b border-zinc-200 pb-2 text-xl font-semibold text-zinc-950"><%= country.presence || "Other locations" %></h2>
      <div class="space-y-6" data-location-country-body>
        <% country_locations.chunk { |location| location.state_name.to_s }.each do |state, state_locations| %>
          <section data-location-state-group="<%= state %>">
            <% if state.present? %><h3 class="mb-3 text-lg font-semibold text-zinc-700"><%= state %></h3><% end %>
            <%= render "locations/cards", locations: state_locations, heading_tag: state.present? ? :h4 : :h3 %>
          </section>
        <% end %>
      </div>
    </section>
  <% end %>
<% else %>
  <%= render "locations/cards", locations: locations %>
<% end %>

<% if @next_location_page.present? %>
  <div class="py-6 text-center text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500"
       data-infinite-scroll-target="sentinel"
       data-next-url="<%= locations_path(page: @next_location_page) %>">
    Loading more locations...
  </div>
<% end %>

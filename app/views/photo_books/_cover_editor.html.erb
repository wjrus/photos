<% back = @selected_key == "back" %>
<section class="photobook-card photobook-page-editor">
  <h2><%= back ? "Back cover" : "Front cover" %></h2>
  <%= form_with model: @book, class: "photobook-fields", data: { photobook_designer_target: "form", action: "input->photobook-designer#schedulePreview change->photobook-designer#schedulePreview submit->photobook-designer#saving", cover: true } do |form| %>
    <%= form.hidden_field :lock_version %><%= hidden_field_tag :preview_key, @selected_key %>
    <%= hidden_field_tag :view, @preview_mode, data: { photobook_designer_target: "previewView" } %>
    <div><%= form.label :cover_layout, "Cover photo layout" %><%= form.select :cover_layout, [["Whole photo with whitespace", "fit"], ["Full cover photo", "full"]], {}, data: { photobook_designer_target: "layout" } %></div>
    <div data-photobook-designer-target="primary"><%= render "photo_slot", form: form, field: back ? :back_photo_id : :cover_photo_id, slot: "primary", label: "Cover photo", photo: @preview_photos[back ? @book.back_photo_id : @book.cover_photo_id] %></div>
    <div class="photobook-focus" data-photobook-designer-target="coverPosition">
      <p class="photobook-note">Drag the preview photo to position it. Use sliders or arrow keys for finer control.</p>
      <%= form.label back ? :back_focus_x : :cover_focus_x, "Cover photo horizontal position" %><%= form.range_field back ? :back_focus_x : :cover_focus_x, min: 0, max: 100, step: 1, data: { crop_slot: "primary", crop_axis: "x" } %>
      <%= form.label back ? :back_focus_y : :cover_focus_y, "Cover photo vertical position" %><%= form.range_field back ? :back_focus_y : :cover_focus_y, min: 0, max: 100, step: 1, data: { crop_slot: "primary", crop_axis: "y" } %>
      <button type="button" class="photobook-button" data-action="photobook-designer#centerCoverPhoto">Center photo</button>
    </div>
    <% if back %>
      <div><%= form.label :back_text, "Back cover text" %><%= form.text_area :back_text, rows: 4, maxlength: 2000 %></div>
    <% else %>
      <div><%= form.label :cover_title, "Cover title" %><%= form.text_area :cover_title, rows: 2, maxlength: 200 %></div>
      <div><%= form.label :cover_subtitle, "Cover subtitle" %><%= form.text_area :cover_subtitle, rows: 2, maxlength: 200 %></div>
    <% end %>
    <%= render "cover_typography", form: form, book: @book, back: back %>
    <p class="photobook-note" data-photobook-designer-target="status" role="status">Drag a photo from the tray, then edit the cover text and layout.</p>
    <%= form.submit "Save cover", class: "photobook-button photobook-button-primary" %>
  <% end %>
</section>

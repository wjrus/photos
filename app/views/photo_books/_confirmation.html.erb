<%= form_with url: url, method: local_assigns.fetch(:method, :delete), id: "#{id}-form", data: local_assigns.fetch(:form_data, {}) do %>
  <div data-controller="confirm-modal" data-action="keydown@window->confirm-modal#keydown" data-photobook-designer-target="<%= local_assigns[:designer_target] %>">
    <% if button_label.present? %><button type="button" class="photobook-button" data-action="confirm-modal#open"><%= button_label %></button><% end %>
    <div class="fixed inset-0 z-50 hidden items-center justify-center bg-zinc-950/65 p-4 text-left backdrop-blur-sm"
         role="dialog" aria-modal="true" aria-labelledby="<%= id %>-title" aria-describedby="<%= id %>-description"
         data-confirm-modal-target="dialog" data-action="click->confirm-modal#backdrop">
      <div class="w-full max-w-sm rounded-lg border border-rose-200 bg-white p-5 text-zinc-950 shadow-2xl" data-confirm-modal-target="panel">
        <h2 id="<%= id %>-title" class="text-lg font-semibold text-zinc-950"><%= title %></h2>
        <p id="<%= id %>-description" class="mt-3 text-sm leading-6 text-zinc-600"><%= body %></p>
        <div class="mt-5 grid grid-cols-2 gap-3">
          <button type="button" class="rounded-lg border border-zinc-300 px-3 py-2 text-xs font-semibold uppercase text-zinc-800 transition hover:border-zinc-950 hover:bg-zinc-950 hover:text-white" data-action="confirm-modal#close">Cancel</button>
          <button type="submit" class="rounded-lg bg-rose-800 px-3 py-2 text-xs font-semibold uppercase text-white transition hover:bg-rose-950"><%= confirm_label %></button>
        </div>
      </div>
    </div>
  </div>
<% end %>

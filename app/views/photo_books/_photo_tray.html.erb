<%= turbo_frame_tag "photobook-tray", data: { photobook_designer_target: "tray", turbo: false } do %>
  <div class="photobook-tray-heading"><h2>Photo tray</h2><p class="photobook-note"><%= @tray_unused_count %> unused <%= "photo".pluralize(@tray_unused_count) %></p></div>
  <p class="photobook-note">Drag onto the page, or select a photo then its photo area.</p>
  <%= form_with url: tray_photo_book_path(@book), method: :get, class: "photobook-tray-search", data: { action: "submit->photobook-designer#searchTray" } do %>
    <%= hidden_field_tag :preview_key, @selected_key %>
    <%= hidden_field_tag :page_id, @selected_page.id if @selected_page %>
    <%= label_tag :tray_search, "Find a tray photo" %><%= search_field_tag :tray_search, @tray_search, placeholder: "Photo name", id: "tray_search" %>
    <div class="photobook-tray-tools"><%= submit_tag "Find", class: "photobook-button" %><label class="photobook-checkbox"><%= check_box_tag :show_used, "1", @tray_show_used, data: { action: "change->photobook-designer#searchTray" } %>Show used photos</label></div>
  <% end %>
  <div class="photobook-tray-grid">
    <% @tray_photos.each do |photo| %>
      <button type="button" draggable="true" class="photobook-tray-photo" data-photobook-designer-target="trayPhoto" data-action="click->photobook-designer#selectPhoto dragstart->photobook-designer#dragStart dragend->photobook-designer#dragEnd" data-photo-id="<%= photo.id %>" data-photo-title="<%= photo.title %>" data-image-url="<%= stream_photo_path(photo) %>" data-caption="<%= photo.description.to_s.first(2000) %>" aria-label="Select <%= photo.title %>" aria-pressed="false">
        <%= image_tag stream_photo_path(photo), alt: "", loading: "lazy", decoding: "async", draggable: false %><span><%= photo.title %></span>
        <% if @tray_used_ids.include?(photo.id) %><span class="photobook-tray-used">Used in book</span><% end %>
      </button>
    <% end %>
  </div>
  <% if @tray_photos.empty? %><p class="photobook-note"><%= @tray_search.present? ? "No matching photos." : @tray_show_used ? "No photos assigned yet." : "All available photos are placed, or no photos have been added yet." %> <%= link_to "Add book photos", photo_book_path(@book, tab: "photos"), data: { turbo_frame: "_top" } %><%= " or show used photos to reuse one." unless @tray_show_used %></p><% end %>
  <div class="photobook-pagination photobook-tray-pagination">
    <%= link_to "Previous", tray_photo_book_path(@book, preview_key: @selected_key, page_id: @selected_page&.id, tray_page: @tray_page - 1, tray_search: @tray_search, show_used: @tray_show_used ? "1" : "0"), class: "photobook-button", data: { action: "photobook-designer#browseTray", tray_page: @tray_page - 1 } if @tray_page > 1 %>
    <%= link_to "More photos", tray_photo_book_path(@book, preview_key: @selected_key, page_id: @selected_page&.id, tray_page: @tray_next_page, tray_search: @tray_search, show_used: @tray_show_used ? "1" : "0"), class: "photobook-button", data: { action: "photobook-designer#browseTray", tray_page: @tray_next_page } if @tray_next_page %>
  </div>
<% end %>

<% selected = preview_pages.compact.find { |page| page.fetch(:key) == selected_key } || preview_pages.compact.first %>
<div id="photobook-preview" class="photobook-preview" aria-label="<%= preview_mode == 'spread' && selected[:number] ? 'Facing-page preview' : 'Single-page preview' %>">
  <div class="photobook-preview-heading">
    <div class="photobook-page-position" role="group" aria-label="Page position in book">
      <span class="photobook-position-icon <%= selected[:number] ? 'is-open-book' : 'is-cover' %>" aria-hidden="true">
        <% if selected[:number] %><span class="<%= 'is-active' if selected[:side] == 'left' %>"></span><span class="<%= 'is-active' if selected[:side] == 'right' %>"></span><% else %><span class="is-active"></span><% end %>
      </span>
      <span><%= selected.fetch(:label) %><%= " · #{selected.fetch(:side).capitalize} page" if selected[:number] %></span>
    </div>
    <% if selected[:number] %>
      <div class="photobook-preview-switch" role="group" aria-label="Preview view">
        <button type="button" data-action="photobook-designer#changePreviewView" data-photobook-designer-target="previewToggle" data-preview-view="page" aria-pressed="<%= preview_mode == 'page' %>">Single page</button>
        <button type="button" data-action="photobook-designer#changePreviewView" data-photobook-designer-target="previewToggle" data-preview-view="spread" aria-pressed="<%= preview_mode == 'spread' %>">Facing pages</button>
      </div>
    <% end %>
  </div>
  <div class="photobook-preview-pages <%= 'is-spread' if preview_pages.size > 1 %>">
    <% preview_pages.each_with_index do |page, index| %>
      <% if page %>
        <% editable = page.fetch(:key).split("-").first == selected_key.to_s.split("-").first %>
        <div class="photobook-preview-leaf">
          <% if editable %>
            <div class="photobook-preview-page is-selected" aria-label="<%= page.fetch(:label) %> selected">
              <%= render "page_artwork", page: page, layout: layout, photos: photos, prefix: "preview-#{index}" %>
              <% areas = page.fetch(:images).presence || [{ x: page.fetch(:offset), y: 0, width: page.fetch(:width), height: page.fetch(:height), photo_id: nil }] %>
              <% areas.each_with_index do |area, slot_index| %>
                <% photo = photos[area[:photo_id]]; dimensions = photo ? PhotoBook.oriented_dimensions(photo) : [] %>
                <% reposition = area[:fit] == "fill" && dimensions.all? { |value| value.to_f.positive? } && photo.present? %>
                <% left = [area.fetch(:x) - page.fetch(:offset), 0].max; right = [area.fetch(:x) + area.fetch(:width) - page.fetch(:offset), page.fetch(:width)].min %>
                <button type="button" class="photobook-drop-zone <%= "is-filled" if photo %> <%= "is-repositionable" if reposition %>" style="left: <%= left / page.fetch(:width) * 100 %>%; top: <%= area.fetch(:y) / page.fetch(:height) * 100 %>%; width: <%= (right - left) / page.fetch(:width) * 100 %>%; height: <%= area.fetch(:height) / page.fetch(:height) * 100 %>%" data-photo-slot="<%= slot_index.zero? ? "primary" : "secondary" %>"
                        data-photo-reposition="<%= reposition %>" data-crop-x="<%= area.fetch(:x) %>" data-crop-y="<%= area.fetch(:y) %>" data-crop-width="<%= area.fetch(:width) %>" data-crop-height="<%= area.fetch(:height) %>" data-photobook-designer-target="<%= "cropHandle" if reposition %>"
                        data-action="click->photobook-designer#chooseSlot dragover->photobook-designer#dragOver dragleave->photobook-designer#dragLeave drop->photobook-designer#dropPhoto pointerdown->photobook-designer#startPhotoDrag pointermove->photobook-designer#movePhotoDrag pointerup->photobook-designer#endPhotoDrag pointercancel->photobook-designer#cancelPhotoDrag lostpointercapture->photobook-designer#cancelPhotoDrag keydown->photobook-designer#nudgePhoto"
                        aria-label="<%= reposition ? "Position or replace #{slot_index.zero? ? 'first' : 'second'} photo on #{page.fetch(:label).downcase}" : "Place or replace #{slot_index.zero? ? 'first' : 'second'} photo on #{page.fetch(:label).downcase}" %>"><span><%= reposition ? "Drag to position photo" : slot_index.zero? ? "Drop a photo here" : "Drop second photo here" %></span></button>
              <% end %>
            </div>
          <% else %>
            <%= link_to photo_book_path(book, page_id: page.fetch(:key)), aria: { label: "Edit #{page.fetch(:label).downcase}" }, class: "photobook-preview-page" do %>
              <%= render "page_artwork", page: page, layout: layout, photos: photos, prefix: "preview-#{index}" %>
            <% end %>
          <% end %>
          <% if preview_pages.size > 1 %><p><%= page.fetch(:label) %><%= page[:side] ? " · #{page[:side]}" : "" %></p><% end %>
        </div>
      <% else %>
        <div class="photobook-preview-leaf"><div class="photobook-unprinted-page" style="aspect-ratio: <%= book.dimensions.fetch(:width) %> / <%= book.dimensions.fetch(:height) %>"></div><p>Inside cover · unprinted</p></div>
      <% end %>
    <% end %>
  </div>
  <% if layout.errors.any? %><p class="photobook-preview-warning" role="status"><%= layout.errors.uniq.to_sentence %></p><% end %>
</div>

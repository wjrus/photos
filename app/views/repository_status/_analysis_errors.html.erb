<% if runs.any? %>
  <div class="mt-5 border-t border-zinc-100 pt-4" data-analysis-errors>
    <h4 class="text-xs font-semibold uppercase tracking-wider text-zinc-500">Latest errors</h4>
    <ul class="mt-2 divide-y divide-zinc-100">
      <% runs.each do |run| %>
        <li class="py-2">
          <details id="analysis-error-<%= run.fetch('id') %>" class="min-w-0">
            <summary class="cursor-pointer text-xs text-zinc-700"><span class="font-semibold">Photo <%= run.fetch("photo_id") %></span><span class="ml-1 text-zinc-500">Run #<%= run.fetch("id") %></span><span class="mt-1 block truncate text-zinc-600"><%= run.fetch("error") %></span></summary>
            <p class="mt-2 break-words text-xs leading-5 text-rose-800"><%= run.fetch("error") %></p>
            <%= link_to "Open photo", photo_path(run.fetch("photo_id")), class: "mt-2 inline-flex text-xs font-semibold text-teal-800 underline underline-offset-4" %>
          </details>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

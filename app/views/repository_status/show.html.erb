<% content_for :title, "Repository status" %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% section_params = { section: @status_section } %>

<section class="min-h-screen bg-stone-50 text-zinc-950">
  <%= render "shared/site_header" %>
  <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <header>
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700">Owner</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Repository status</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-zinc-600">Keep files healthy, manage background work, and track photo analysis. Each panel updates independently while this page is open.</p>
    </header>
    <%= render "shared/repository_nav" %>

    <% if @status_section == "overview" %>
      <div class="mt-6 grid gap-5 lg:grid-cols-2">
        <%= render "panel", panel: "queues", title: "Background work", interval: 20, variant: "summary" %>
        <%= render "panel", panel: "library", title: "Library", interval: 300 %>
      </div>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <%= link_to repository_status_path(section: "files"), class: "rounded-xl border border-zinc-200 bg-white p-5 transition hover:border-teal-700" do %>
          <h2 class="font-semibold text-zinc-950">Files & storage <span aria-hidden="true">→</span></h2>
          <p class="mt-1 text-sm leading-6 text-zinc-600">Review file health, run checks, and manage backups, derivatives, and location matching.</p>
        <% end %>
        <%= link_to repository_status_path(section: "analysis"), class: "rounded-xl border border-zinc-200 bg-white p-5 transition hover:border-teal-700" do %>
          <h2 class="font-semibold text-zinc-950">Photo analysis <span aria-hidden="true">→</span></h2>
          <p class="mt-1 text-sm leading-6 text-zinc-600">Track search and caption coverage, run batches, and manage providers and spending.</p>
        <% end %>
      </div>
      <div class="mt-5"><%= render "panel", panel: "activity", title: "Repository activity", interval: 60 %></div>
    <% elsif @status_section == "files" %>
      <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div><h2 class="text-lg font-semibold">Protect your originals</h2><p class="mt-1 text-sm text-zinc-600">Patrol checks a normal batch. A baseline scan covers originals that have never been checked.</p></div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <%= button_to "Queue patrol", repository_status_path, method: :post, params: section_params.merge(scan_type: "patrol", batch_size: OriginalFileHealthPatrolJob::DEFAULT_BATCH_SIZE), class: repository_button_class(primary: true) %>
          <%= button_to "Queue baseline scan", repository_status_path, method: :post, params: section_params.merge(scan_type: "baseline"), class: repository_button_class %>
        </div>
      </div>
      <div class="mt-5"><%= render "panel", panel: "health", title: "File health", interval: 60 %></div>
      <div class="mt-5 grid gap-5 lg:grid-cols-2">
        <section class="rounded-xl border border-zinc-200 bg-white p-5">
          <% auto_heal = @settings.fetch(AppSetting::ORIGINAL_FILE_AUTO_HEAL, false) %>
          <div class="flex items-start justify-between gap-3"><h2 class="font-semibold">Original file auto-heal</h2><%= repository_badge(auto_heal ? "Enabled" : "Disabled", tone: auto_heal ? :good : :neutral) %></div>
          <p class="mt-2 text-sm leading-6 text-zinc-600">Restore archived originals from Drive when a health check finds a problem.</p>
          <p class="mt-1 text-xs text-zinc-500">Source: <%= @setting_sources.fetch(AppSetting::ORIGINAL_FILE_AUTO_HEAL, "app default") %></p>
          <%= button_to auto_heal ? "Disable auto-heal" : "Enable auto-heal", repository_status_path, method: :patch, params: section_params.merge(control: "original_file_auto_heal", enabled: (!auto_heal).to_s), class: "mt-4 #{repository_button_class}" %>
        </section>
        <section class="rounded-xl border border-zinc-200 bg-white p-5">
          <div class="flex items-start justify-between gap-3"><h2 class="font-semibold">Google Drive authorization</h2><%= repository_badge(current_user.google_drive_authorized? ? "Connected" : "Not connected", tone: current_user.google_drive_authorized? ? :good : :warning) %></div>
          <p class="mt-2 text-sm leading-6 text-zinc-600">Owner access for archive mirrors and restoring original files.</p>
          <%= button_to current_user.google_drive_authorized? ? "Reconnect Drive" : "Connect Drive", "/auth/google_oauth2", method: :post, params: { access_type: "offline", include_granted_scopes: "true", origin: repository_status_path(section: "files"), prompt: "consent select_account", scope: "openid,email,profile,#{GoogleDriveArchiveClient::DRIVE_SCOPE}" }, data: { turbo: false }, class: "mt-4 #{repository_button_class}" %>
        </section>
      </div>
      <div class="mt-5"><%= render "panel", panel: "maintenance", title: "Storage & processing", interval: 300 %></div>
      <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-zinc-600">Match remaining geotagged photos to place names.</p>
        <%= button_to "Queue location names", repository_status_path, method: :post, params: section_params.merge(scan_type: "geocode_locations", limit: GeocodeMissingPhotoLocationsJob::MAX_LIMIT), class: repository_button_class %>
      </div>
    <% elsif @status_section == "analysis" %>
      <div class="mt-6 space-y-5" data-analysis-dashboard>
        <%= render "panel", panel: "analysis", title: "Analysis coverage", interval: 60 %>
        <section class="rounded-xl border border-zinc-200 bg-white p-5" data-analysis-actions>
          <h2 class="text-base font-semibold">Run photo analysis</h2>
          <div class="mt-4 grid gap-6 lg:grid-cols-2">
            <%= form_with url: repository_status_path, method: :post, class: "space-y-3" do |form| %>
              <%= form.hidden_field :section, value: @status_section, id: nil %><%= form.hidden_field :scan_type, value: "analysis", id: nil %>
              <h3 class="text-sm font-semibold">Local analysis</h3>
              <div class="grid gap-3 sm:grid-cols-2">
                <div><%= form.label :providers, "Provider", class: "block text-xs font-semibold text-zinc-600" %><%= form.select :providers, [["Enabled local providers", ""], ["OpenCLIP", "openclip"], ["YOLO", "yolo"]], {}, class: "mt-1 w-full rounded-lg border-zinc-300 text-sm" %></div>
                <div><%= form.label :batch_size, "Photos per batch", for: "local-analysis-batch", class: "block text-xs font-semibold text-zinc-600" %><%= form.number_field :batch_size, id: "local-analysis-batch", value: ENV.fetch("ANALYSIS_BACKFILL_BATCH_SIZE", PhotoAnalysisBackfillJob::DEFAULT_BATCH_SIZE), min: 1, max: PhotoAnalysisBackfillJob::MAX_BATCH_SIZE, required: true, list: "local-analysis-batches", class: "mt-1 w-full rounded-lg border-zinc-300 text-sm" %><datalist id="local-analysis-batches"><option value="1000"></option><option value="5000"></option></datalist></div>
              </div>
              <p class="text-xs leading-5 text-zinc-500">Only enabled providers run. Choose a small batch or use 1,000 or 5,000 for a larger backfill.</p>
              <%= form.submit "Queue local analysis", class: repository_button_class(primary: true) %>
            <% end %>
            <%= form_with url: repository_status_path, method: :post, class: "space-y-3 border-t border-zinc-100 pt-5 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0" do |form| %>
              <%= form.hidden_field :section, value: @status_section, id: nil %><%= form.hidden_field :scan_type, value: "openrouter_analysis", id: nil %>
              <h3 class="text-sm font-semibold">Paid Qwen vision</h3>
              <div><%= form.label :batch_size, "Photos per batch", for: "openrouter-analysis-batch", class: "block text-xs font-semibold text-zinc-600" %><%= form.select :batch_size, [["25 photos", 25], ["100 photos", 100], ["1,000 photos", 1000]], {}, id: "openrouter-analysis-batch", class: "mt-1 w-full rounded-lg border-zinc-300 text-sm" %></div>
              <p class="text-xs leading-5 text-zinc-500">Uses the configured OpenRouter provider and budget. Start with 25 photos to assess captions and cost.</p>
              <%= form.submit "Queue Qwen captions", class: repository_button_class %>
            <% end %>
          </div>
        </section>
        <details class="rounded-xl border border-zinc-200 bg-white p-5" data-analysis-feature-flags>
          <summary class="cursor-pointer text-base font-semibold">Analysis settings</summary>
          <p class="mt-2 text-sm text-zinc-600">Enable providers and choose when external analysis is allowed.</p>
          <dl class="mt-4 grid gap-x-8 md:grid-cols-2">
            <% AppSetting::ANALYSIS_BOOLEAN_SETTINGS.each do |key, default| %>
              <% enabled = @settings.fetch(key, default) %>
              <div class="flex min-w-0 items-center justify-between gap-3 border-t border-zinc-100 py-4">
                <div class="min-w-0"><dt class="text-sm font-medium"><%= repository_analysis_setting_label(key) %></dt><dd class="mt-1 text-xs text-zinc-500"><%= enabled ? "Enabled" : "Disabled" %> · <%= @setting_sources.fetch(key, "app default") %></dd></div>
                <dd><%= button_to enabled ? "Disable" : "Enable", repository_status_path, method: :patch, params: section_params.merge(control: "analysis", setting_key: key, enabled: (!enabled).to_s), aria: { label: "#{enabled ? 'Disable' : 'Enable'} #{repository_analysis_setting_label(key)}" }, class: repository_button_class %></dd>
              </div>
            <% end %>
          </dl>
        </details>
      </div>
    <% elsif @status_section == "queues" %>
      <div class="mt-6"><%= render "panel", panel: "queues", title: "Queues", interval: 20 %></div>
    <% end %>
  </main>
</section>

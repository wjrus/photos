<% variant = local_assigns[:variant] %>
<% panel_id = "repository-#{panel}#{"-#{variant}" if variant.present?}" %>
<% initial_data = @panel_data && (@panel_data[panel.to_s] || @panel_data[panel.to_sym]) %>
<section id="<%= panel_id %>" class="min-w-0 rounded-xl border border-zinc-200 bg-white shadow-sm"
         aria-labelledby="<%= panel_id %>-title"
         data-controller="repository-panel" data-repository-panel="<%= panel %>"
         data-repository-panel-url-value="<%= repository_status_panel_path(panel: panel, variant: variant) %>"
         data-repository-panel-interval-value="<%= interval %>">
  <div class="flex items-start justify-between gap-4 border-b border-zinc-100 px-5 py-4">
    <div class="min-w-0">
      <h2 id="<%= panel_id %>-title" class="text-base font-semibold text-zinc-950"><%= title %></h2>
      <p class="mt-1 text-xs text-zinc-500" data-repository-panel-target="status"><%= initial_data ? "Loaded" : "Loading…" %></p>
    </div>
    <button type="button" class="shrink-0 rounded-md border border-zinc-200 px-3 py-1.5 text-xs font-semibold text-zinc-600 transition hover:border-zinc-500 hover:text-zinc-950" aria-label="Refresh <%= title.downcase %>" data-action="repository-panel#refresh" data-repository-panel-target="retry">Refresh</button>
  </div>
  <div class="min-w-0 p-5" data-repository-panel-target="content">
    <% if initial_data %>
      <%= render "repository_status/panels/#{panel}#{"_summary" if variant == "summary"}", data: initial_data %>
    <% else %>
      <div class="space-y-3 py-2" aria-hidden="true">
        <div class="h-4 w-2/3 rounded bg-zinc-100"></div><div class="h-4 w-1/2 rounded bg-zinc-100"></div><div class="h-4 w-1/3 rounded bg-zinc-100"></div>
      </div>
    <% end %>
  </div>
  <noscript><p class="px-5 pb-5 text-sm text-zinc-600"><%= link_to "Load status without automatic updates", repository_status_path(section: @status_section, synchronous: 1), class: "underline underline-offset-4" %></p></noscript>
</section>

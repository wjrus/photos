<% health = data.fetch(:health) %>
<% timeline = data.fetch(:health_timeline) %>
<% timeline_total = timeline.sum { |bucket| bucket.fetch(:healthy) + bucket.fetch(:attention) } %>
<% max_hour = [timeline.map { |bucket| bucket.fetch(:healthy) + bucket.fetch(:attention) }.max.to_i, 1].max %>
<dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
  <%= repository_metric("Checked", number_with_delimiter(health.fetch(:checked)), detail: "#{health.fetch(:checked_percent)}% of originals") %>
  <%= repository_metric("Never checked", number_with_delimiter(health.fetch(:unchecked))) %>
  <%= repository_metric("Needs attention", number_with_delimiter(health.fetch(:attention)), attention: health.fetch(:attention).positive?) %>
  <%= repository_metric("Stale checks", number_with_delimiter(health.fetch(:stale)), detail: "Older than #{distance_of_time_in_words(OriginalFileHealthPatrolJob::DEFAULT_STALE_AFTER)}") %>
</dl>

<div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <section class="min-w-0">
    <div class="flex flex-wrap items-center justify-between gap-2"><h3 class="text-sm font-semibold">Checks in the last 24 hours</h3><p class="text-xs text-zinc-500"><% if data[:last_health_check_at] %>Last check <%= repository_timestamp(data.fetch(:last_health_check_at)) %><% else %>No checks yet<% end %></p></div>
    <% if timeline_total.zero? %>
      <p class="mt-3 rounded-lg border border-dashed border-zinc-200 bg-stone-50 p-8 text-center text-sm text-zinc-500">No file health checks ran in the last 24 hours.</p>
    <% else %>
      <div class="mt-4 flex h-28 items-end gap-1" role="img" aria-label="<%= number_with_delimiter(timeline_total) %> file health checks in the last 24 hours">
        <% timeline.each do |bucket| %>
          <% total = bucket.fetch(:healthy) + bucket.fetch(:attention) %>
          <% height = total.positive? ? [(total.to_f / max_hour * 100).round(1), 4].max : 1 %>
          <% attention_percent = total.positive? ? (bucket.fetch(:attention).to_f / total * 100).round(1) : 0 %>
          <div class="flex min-w-0 flex-1 flex-col-reverse overflow-hidden rounded-t bg-zinc-100" style="height: <%= height %>%" title="<%= bucket.fetch(:label) %>: <%= total %> checks, <%= bucket.fetch(:attention) %> needing attention">
            <% if total.positive? %><div class="bg-teal-700" style="height: <%= 100 - attention_percent %>%"></div><div class="bg-rose-500" style="height: <%= attention_percent %>%"></div><% end %>
          </div>
        <% end %>
      </div>
      <div class="mt-2 flex justify-between text-xs text-zinc-500"><span>24h ago</span><span>Now</span></div>
      <p class="mt-2 text-xs text-zinc-500">Teal: healthy or healed · Red: needs attention</p>
    <% end %>
  </section>
  <section>
    <h3 class="text-sm font-semibold">Health jobs</h3>
    <dl class="mt-3 space-y-2 text-sm">
      <% { "Queued" => :ready, "Running" => :claimed, "Scheduled" => :scheduled, "Failed" => :failed, "Blocked" => :blocked }.each do |label, state| %>
        <% count = health.fetch(:jobs).fetch(state, 0) %><div class="flex justify-between gap-3"><dt class="text-zinc-600"><%= label %></dt><dd class="font-semibold <%= state == :failed && count.positive? ? 'text-rose-800' : '' %>"><%= number_with_delimiter(count) %></dd></div>
      <% end %>
    </dl>
    <% if health.fetch(:jobs).fetch(:claimed, 0).positive? %><p class="mt-3 text-xs leading-5 text-zinc-500">Large videos can take minutes because checks read the entire original.</p><% end %>
    <%= link_to "Manage queues →", repository_status_path(section: "queues"), class: "mt-3 inline-flex text-xs font-semibold text-teal-800 underline underline-offset-4" %>
  </section>
</div>

<% if data.fetch(:recent_attention).any? %>
  <section class="mt-6 border-t border-zinc-100 pt-5">
    <h3 class="text-sm font-semibold text-rose-900">Needs attention</h3>
    <ul class="mt-3 divide-y divide-rose-100 rounded-lg border border-rose-100 bg-rose-50 px-4">
      <% data.fetch(:recent_attention).each do |check| %>
        <li class="py-3">
          <div class="flex flex-wrap items-center justify-between gap-2"><%= link_to check.fetch("photo_filename"), photo_path(check.fetch("photo_id")), class: "min-w-0 break-all text-sm font-semibold text-rose-900 underline underline-offset-4" %><%= repository_badge(check.fetch("status").humanize, tone: :danger) %></div>
          <% if check["error"].present? %><p class="mt-1 break-words text-xs leading-5 text-rose-800"><%= check.fetch("error") %></p><% end %>
          <p class="mt-1 text-xs text-rose-800"><%= repository_timestamp(check.fetch("checked_at")) %></p>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<details id="health-check-details" class="mt-6 border-t border-zinc-100 pt-5">
  <summary class="cursor-pointer text-sm font-semibold">Recent checks & fingerprints <span class="font-normal text-zinc-500">(<%= data.fetch(:recent_checks).size %>)</span></summary>
  <% if data.fetch(:recent_checks).any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[38rem] text-left text-sm">
        <thead class="border-b border-zinc-200 text-xs uppercase tracking-wider text-zinc-500"><tr><th scope="col" class="py-3 pr-3">Photo</th><th scope="col" class="p-3">Status</th><th scope="col" class="p-3 text-right">Expected</th><th scope="col" class="p-3 text-right">Actual</th><th scope="col" class="p-3">Checked</th></tr></thead>
        <tbody class="divide-y divide-zinc-100">
          <% data.fetch(:recent_checks).each do |check| %>
            <tr>
              <td class="max-w-64 py-3 pr-3"><%= link_to check.fetch("photo_filename"), photo_path(check.fetch("photo_id")), class: "block truncate font-medium underline decoration-zinc-300 underline-offset-4", title: check.fetch("photo_filename") %></td>
              <td class="p-3"><%= repository_badge(check.fetch("status").humanize, tone: FileHealthCheck::ATTENTION_STATUSES.include?(check.fetch("status")) ? :danger : :good) %></td>
              <td class="p-3 text-right text-zinc-600"><%= check["expected_byte_size"] ? number_to_human_size(check.fetch("expected_byte_size")) : "—" %></td>
              <td class="p-3 text-right text-zinc-600"><%= check["actual_byte_size"] ? number_to_human_size(check.fetch("actual_byte_size")) : "—" %></td>
              <td class="p-3 text-zinc-500"><%= repository_timestamp(check.fetch("checked_at")) %></td>
            </tr>
            <tr><td colspan="5" class="pb-3"><details id="health-fingerprint-<%= check.fetch('id') %>"><summary class="cursor-pointer text-xs text-zinc-500">Fingerprints<%= " and error" if check["error"].present? %></summary><dl class="mt-2 space-y-2 rounded-lg bg-stone-50 p-3 font-mono text-xs">
              <% { "Blob key" => check["blob_key"], "MD5" => check["actual_checksum_md5"].presence || check["expected_checksum_md5"], "SHA-256" => check["actual_checksum_sha256"].presence || check["expected_checksum_sha256"] }.each do |label, value| %><div><dt class="text-zinc-500"><%= label %></dt><dd class="mt-1 break-all"><%= value.presence || "unknown" %></dd></div><% end %>
            </dl><% if check["error"].present? %><p class="mt-2 break-words text-xs leading-5 text-rose-800"><%= check.fetch("error") %></p><% end %></details></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %><p class="mt-3 text-sm text-zinc-500">No file health checks have run yet.</p><% end %>
</details>

<details id="health-status-details" class="mt-5 border-t border-zinc-100 pt-5">
  <summary class="cursor-pointer text-sm font-semibold">Status breakdown</summary>
  <dl class="mt-4 grid gap-x-8 gap-y-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
    <% FileHealthCheck::STATUSES.each do |status| %><% count = health.fetch(:status_counts).fetch(status, 0) %><div class="flex justify-between gap-3"><dt class="text-zinc-600"><%= status.humanize %></dt><dd class="font-semibold <%= FileHealthCheck::ATTENTION_STATUSES.include?(status) && count.positive? ? 'text-rose-800' : '' %>"><%= number_with_delimiter(count) %></dd></div><% end %>
  </dl>
</details>
